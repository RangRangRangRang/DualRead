@model List<Book>
@{
    ViewData["Title"] = "Library";
    var currentLang = (string)(ViewBag.Language ?? "en");
}

<div class="library-page">
    <div class="library-header">
        <h1 data-i18n="library">Library</h1>
        <div class="library-header-actions">
            <div class="lang-segmented-control" role="group" aria-label="Language">
                <button type="button" class="lang-seg-btn @(currentLang == "en" ? "active" : "")" data-lang="en">EN</button>
                <button type="button" class="lang-seg-btn @(currentLang == "vi" ? "active" : "")" data-lang="vi">VI</button>
            </div>
            <button type="button" id="open-vocab-modal-btn" class="lib-btn lib-btn-secondary" title="View all saved vocabulary" data-i18n-title="vocabNotebookTitle">
                <span data-i18n="vocabNotebook">Vocabulary Bank</span>
                <span id="library-vocab-total-count" class="lib-badge-count" style="display:none;">0</span>
            </button>
            <button type="button" class="lib-btn lib-btn-key recovery-badge-btn" title="Click to copy recovery key" data-i18n-title="copyRecoveryKeyTitle"
                    data-copy-key="@ViewBag.RecoveryKeyCode">
                <span class="recovery-badge-text">@ViewBag.RecoveryKeyCode</span>
            </button>
            <a class="lib-btn lib-btn-primary" asp-controller="Library" asp-action="Upload" data-i18n="upload">+ Upload</a>
        </div>
    </div>

    @if (TempData["JustCreatedKey"] is string newKey && !string.IsNullOrEmpty(newKey))
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between gap-3">
            <span>Save this recovery key somewhere safe - it's the only way back into your library: <strong>@newKey</strong></span>
            <button type="button" class="btn btn-sm btn-outline-dark flex-shrink-0" data-copy-key="@newKey">Copy</button>
        </div>
    }

    @if (TempData["UploadSuccessCount"] is int successCount && successCount > 0)
    {
        <div class="alert alert-success">
            <strong>Uploaded @successCount file(s) successfully:</strong>
            @if (TempData["UploadSuccessFiles"] is string successFilesRaw && !string.IsNullOrEmpty(successFilesRaw))
            {
                <ul class="mb-0">
                    @foreach (var line in successFilesRaw.Split('|', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </div>
    }

    @if (TempData["UploadErrors"] is string uploadErrorsRaw && !string.IsNullOrEmpty(uploadErrorsRaw))
    {
        <div class="alert alert-danger">
            <strong>Some files failed to upload:</strong>
            <ul class="mb-0">
                @foreach (var line in uploadErrorsRaw.Split('|', StringSplitOptions.RemoveEmptyEntries))
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-secondary" data-i18n="noBooks">No books yet. Upload your first EPUB, PDF, or DOCX to get started.</p>
    }
    else
    {
        <div class="library-toolbar">
            <div class="library-search-box">
                <svg class="library-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5" />
                    <path d="M11.5 11.5L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                <input type="search" id="library-search-input" class="library-search-input"
                       placeholder="Search by title or author…" data-i18n-placeholder="searchPlaceholder" aria-label="Search library" autocomplete="off" />
                <button type="button" id="library-search-clear" class="library-search-clear" aria-label="Clear search" hidden>&times;</button>
            </div>

            <div class="library-toolbar-actions">
                <select id="library-sort-select" class="library-sort-select" aria-label="Sort library">
                    <option value="recent-desc" data-i18n="sortRecentDesc">Newest</option>
                    <option value="recent-asc" data-i18n="sortRecentAsc">Oldest</option>
                    <option value="title-asc" data-i18n="sortTitleAsc">A-Z</option>
                    <option value="title-desc" data-i18n="sortTitleDesc">Z-A</option>
                </select>

                <div class="library-view-toggle" role="group" aria-label="Change view">
                    <button type="button" id="library-view-grid" class="library-view-btn active" data-view="grid" aria-label="Grid view" aria-pressed="true">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.3" />
                            <rect x="9" y="1.5" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.3" />
                            <rect x="1.5" y="9" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.3" />
                            <rect x="9" y="9" width="5.5" height="5.5" rx="1" stroke="currentColor" stroke-width="1.3" />
                        </svg>
                    </button>
                    <button type="button" id="library-view-list" class="library-view-btn" data-view="list" aria-label="List view" aria-pressed="false">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <circle cx="2" cy="3" r="1" fill="currentColor" />
                            <circle cx="2" cy="8" r="1" fill="currentColor" />
                            <circle cx="2" cy="13" r="1" fill="currentColor" />
                            <path d="M5.5 3H14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                            <path d="M5.5 8H14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                            <path d="M5.5 13H14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <p id="library-no-results" class="text-secondary" data-i18n="noResults" hidden>No books match your search.</p>

        <div id="library-sections-container" class="library-sections-container">
            @{
                var formatGroups = Model
                    .GroupBy(b => b.Type)
                    .OrderBy(g => (int)g.Key)
                    .ToList();
            }

            @foreach (var group in formatGroups)
            {
                var formatCode = group.Key.ToString().ToLowerInvariant();
                var formatHeadingKey = $"formatHeading_{formatCode}";

                <section class="library-format-section" data-format="@formatCode">
                    <div class="library-format-header">
                        <div class="library-format-title-group">
                            <span class="format-badge format-badge-@formatCode">@group.Key.ToString().ToUpperInvariant()</span>
                            <h2 class="library-format-heading" data-i18n-format="@formatCode">@group.Key Books</h2>
                            <span class="library-format-count">(@group.Count())</span>
                        </div>
                        <div class="library-format-line"></div>
                    </div>

                    <div class="book-grid">
                        @foreach (var book in group)
                        {
                            <div class="book-card"
                                 data-title="@book.Title.ToLowerInvariant()"
                                 data-author="@((book.Author ?? "").ToLowerInvariant())"
                                 data-uploaded="@book.UploadedAtUtc.Ticks">
                                <a class="book-cover-link" asp-controller="Reader" asp-action="Index" asp-route-id="@book.Id">
                                    <div class="book-cover">
                                        @if (!string.IsNullOrEmpty(book.CoverImagePath))
                                        {
                                            <img src="/library-assets/@book.RecoveryKeyId/@book.Id/@System.IO.Path.GetFileName(book.CoverImagePath)" alt="@book.Title" />
                                        }
                                        else
                                        {
                                            <div class="book-cover-placeholder"></div>
                                        }
                                        <span class="book-type-badge format-badge-@formatCode">@group.Key</span>
                                    </div>
                                    <div class="book-title" title="@book.Title">@book.Title</div>
                                    @if (!string.IsNullOrEmpty(book.Author))
                                    {
                                        <div class="book-author">@book.Author</div>
                                    }
                                </a>
                                <form asp-controller="Library" asp-action="Delete" method="post" onsubmit="return confirm(document.documentElement.lang === 'vi' ? 'Bạn có chắc chắn muốn xóa sách này?' : 'Delete this book?');">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger book-delete-btn" data-i18n="delete">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }

    <!-- Vocabulary Modal (Kho Từ Vựng) -->
    <div id="vocab-modal-backdrop" class="vocab-modal-backdrop" style="display:none;">
        <div class="vocab-modal" role="dialog" aria-modal="true" aria-labelledby="vocab-modal-title">
            <div class="vocab-modal-header">
                <div class="vocab-modal-title-group">
                    <span class="vocab-modal-icon">📖</span>
                    <h2 id="vocab-modal-title" class="vocab-modal-title" data-i18n="vocabModalTitle">Kho Từ Vựng Toàn Thư Viện</h2>
                    <span id="vocab-modal-count-badge" class="vocab-modal-count-badge">0 từ</span>
                </div>
                <button type="button" id="close-vocab-modal-btn" class="vocab-modal-close-btn" aria-label="Đóng">&times;</button>
            </div>

            <div class="vocab-modal-toolbar">
                <div class="vocab-modal-search-box">
                    <svg class="vocab-search-svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5" />
                        <path d="M11.5 11.5L14.5 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <input type="search" id="vocab-modal-search" class="vocab-modal-search-input" placeholder="Tìm kiếm từ gốc, nghĩa..." data-i18n-placeholder="vocabSearchPlaceholder" autocomplete="off" />
                </div>
                <select id="vocab-modal-book-filter" class="vocab-modal-select" aria-label="Lọc theo sách">
                    <option value="" data-i18n="allBooks">Tất cả sách</option>
                </select>
            </div>

            <div class="vocab-modal-body">
                <div id="vocab-modal-list" class="vocab-modal-grid"></div>
                <div id="vocab-modal-empty" class="vocab-modal-empty" style="display: none;">
                    <div class="vocab-empty-icon">🔖</div>
                    <p class="vocab-empty-title" data-i18n="vocabEmptyTitle">Chưa có từ vựng nào</p>
                    <p class="vocab-empty-desc" data-i18n="vocabEmptyDesc">Trong khi đọc sách, hãy bôi đen bất kỳ từ hoặc câu nào và bấm nút ⭐ Lưu từ vựng để ôn tập tại đây.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-copy-key]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var key = btn.getAttribute('data-copy-key');
                    var restore = btn.textContent;
                    navigator.clipboard.writeText(key).then(function() {
                        btn.textContent = 'Copied!';
                        setTimeout(function() { btn.textContent = restore; }, 1500);
                    }).catch(function() { });
                });
            });
        });
    </script>
    <script src="~/js/library.js" asp-append-version="true"></script>
}