@model ReaderBundleViewModel
@{
    ViewData["Title"] = Model.Title;
    var bootstrapJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    });
}

<div id="reader-app" class="reader-app reader-loading" data-book-id="@Model.BookId" data-book-type="@Model.BookType.ToString().ToLowerInvariant()">
    <div id="reader-loading-overlay" class="reader-loading-overlay">
        <div class="reader-loading-spinner"></div>
    </div>

    <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

    <aside id="sidebar-left" class="sidebar sidebar-left">
        <div class="sidebar-section">
            <a class="sidebar-back" data-i18n="backToLibrary" asp-controller="Library" asp-action="Index">&larr; Library</a>
        </div>

        <div class="sidebar-section">
            <button type="button" class="sidebar-toggle" data-i18n="chapters" data-panel="panel-chapters">Chapters</button>
            <div class="chapter-nav-buttons">
                <button type="button" id="prev-chapter-btn" class="chapter-nav-btn" data-i18n-aria="previousChapter" aria-label="Previous chapter" title="Previous chapter">
                    <span aria-hidden="true">&#8249;</span> <span data-i18n="previousChapter">Previous</span>
                </button>
                <button type="button" id="next-chapter-btn" class="chapter-nav-btn" data-i18n-aria="nextChapter" aria-label="Next chapter" title="Next chapter">
                    <span data-i18n="nextChapter">Next</span> <span aria-hidden="true">&#8250;</span>
                </button>
            </div>
            <div class="chapter-list-wrap">
                <ul id="panel-chapters" class="sidebar-panel sidebar-list open"></ul>
                <div class="chapter-scrollbar" id="chapter-scrollbar">
                    <div class="chapter-scrollbar-thumb" id="chapter-scrollbar-thumb"></div>
                </div>
            </div>
        </div>

        <div class="sidebar-section">
            <button type="button" class="sidebar-toggle" data-i18n="bookmarks" data-panel="panel-bookmarks">Bookmarks</button>
            <ul id="panel-bookmarks" class="sidebar-panel sidebar-list open"></ul>
        </div>

        <div class="sidebar-section">
            <button type="button" class="sidebar-toggle" data-i18n="vocabulary" data-panel="panel-vocabulary">
                <span data-i18n="vocabulary">Vocabulary</span> (<span id="vocab-sidebar-count">0</span>)
            </button>
            <div id="panel-vocabulary" class="sidebar-panel sidebar-list open">
                <div class="vocab-sidebar-search-wrap">
                    <input type="search" id="vocab-sidebar-search" class="vocab-sidebar-search-input" placeholder="Search words in this book..." data-i18n-placeholder="vocabSearchPlaceholder" autocomplete="off" />
                </div>
                <ul id="vocab-sidebar-list" class="vocab-sidebar-list"></ul>
                <div id="vocab-sidebar-empty" class="vocab-sidebar-empty" style="display:none;"></div>
            </div>
        </div>
    </aside>

    <main id="reader-center" class="reader-center">
        <div class="reader-topbar">
            <button type="button" id="sidebar-left-toggle" class="icon-toggle-btn sidebar-open-btn" aria-label="Menu" aria-controls="sidebar-left" aria-expanded="false">
                <span aria-hidden="true">&#9776;</span>
            </button>
            <div class="reader-book-title" id="reader-book-title"></div>
            <button type="button" id="translate-toggle" class="translate-toggle-btn" aria-pressed="false" data-i18n-aria="translateToggle" title="Translate this page">
                <span class="translate-toggle-icon" aria-hidden="true">&#127760;</span>
                <span class="translate-toggle-label" data-i18n="translateToggle">Translate this page</span>
            </button>
            <a id="export-translation-btn" class="export-translation-btn" href="@Url.Action("ExportTranslation", "Reader", new { id = Model.BookId })" data-i18n-aria="exportTranslation" title="Export translation (.docx)">
                <span class="export-translation-icon" aria-hidden="true">&#128190;</span>
                <span class="export-translation-label" data-i18n="exportTranslation">Export translation (.docx)</span>
            </a>
            <button type="button" id="sidebar-right-toggle" class="icon-toggle-btn sidebar-open-btn" aria-label="Settings" aria-controls="sidebar-right" aria-expanded="false">
                <span aria-hidden="true">&#9881;</span>
            </button>
        </div>
        <div id="reader-viewport" class="reader-viewport">
            <div id="reader-split" class="reader-split">
                <div id="reader-columns" class="reader-content-box"></div>

                <div id="translation-column" class="translation-column" hidden></div>
            </div>
        </div>
    </main>

    <aside id="sidebar-right" class="sidebar sidebar-right">
        <div class="sidebar-section">
            <label class="settings-label" data-i18n="darkMode">Dark Mode</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="setting-dark-mode" checked>
            </div>
        </div>

        <div class="sidebar-section">
            <label class="settings-label" data-i18n="eyeComfort">Eye Comfort (Sepia)</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="setting-eye-comfort">
            </div>
        </div>

        <div class="sidebar-section">
            <label class="settings-label" for="setting-language" data-i18n="language">Language</label>
            <select id="setting-language" class="form-select form-select-sm settings-input">
                <option value="en">English</option>
                <option value="vi">Tiếng Việt</option>
            </select>
        </div>

        <div class="sidebar-section text-only-setting">
            <label class="settings-label" for="setting-font" data-i18n="font">Font</label>
            <select id="setting-font" class="form-select form-select-sm settings-input">
                <option value="Georgia, serif">Georgia</option>
                <option value="'Times New Roman', serif">Times New Roman</option>
                <option value="'Iowan Old Style', Palatino, serif">Iowan / Palatino</option>
                <option value="Verdana, sans-serif">Verdana</option>
                <option value="'Segoe UI', Arial, sans-serif">Segoe UI</option>
                <option value="'Courier New', monospace">Courier New</option>
            </select>
        </div>

        <div class="sidebar-section text-only-setting">
            <label class="settings-label" for="setting-font-size"><span data-i18n="fontSize">Font Size</span> <span id="setting-font-size-val">18px</span></label>
            <input type="range" min="12" max="48" step="1" id="setting-font-size" value="18" class="form-range">
        </div>

        <div class="sidebar-section text-only-setting">
            <label class="settings-label" for="setting-line-height"><span data-i18n="lineHeight">Line Height</span> <span id="setting-line-height-val">1.7</span></label>
            <input type="range" min="1.2" max="2.4" step="0.1" id="setting-line-height" value="1.7" class="form-range">
        </div>

        <div class="sidebar-section text-only-setting">
            <label class="settings-label" for="setting-letter-spacing"><span data-i18n="letterSpacing">Letter Spacing</span> <span id="setting-letter-spacing-val">0.05em</span></label>
            <input type="range" min="0" max="0.3" step="0.01" id="setting-letter-spacing" value="0.05" class="form-range">
        </div>
    </aside>
</div>

<script id="reader-bootstrap-data" type="application/json">@Html.Raw(bootstrapJson)</script>

@section Scripts {
    <script type="module" src="~/js/reader.js" asp-append-version="true"></script>
}